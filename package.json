{
	"name": "sawitsvelte-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"dev": "pnpm build && pnpm --filter @sawitsvelte/docs dev",
		"check": "pnpm -r check",
		"lint": "eslint .",
		"test": "pnpm -r test",
		"size": "pnpm --filter sawitsvelte size",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript-eslint": "^8.74.0"
	}
}
