{
	"name": "sawitsvelte",
	"version": "0.0.1",
	"description": "A modern, accessible, customizable UI component framework built natively for Svelte 5.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./button": {
			"types": "./dist/button/index.d.ts",
			"svelte": "./dist/button/index.js",
			"default": "./dist/button/index.js"
		},
		"./card": {
			"types": "./dist/card/index.d.ts",
			"svelte": "./dist/card/index.js",
			"default": "./dist/card/index.js"
		},
		"./loader": {
			"types": "./dist/loader/index.d.ts",
			"svelte": "./dist/loader/index.js",
			"default": "./dist/loader/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "svelte-package -i src/lib -o dist && node scripts/build-css.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"size": "node scripts/measure-size.mjs"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sawitsvelte/tokens": "workspace:*",
		"@sawitsvelte/tsconfig": "workspace:*",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@vitest/browser": "^5.1.1",
		"@vitest/browser-playwright": "5.1.1",
		"axe-core": "^4.14.1",
		"playwright": "^1.65.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"tailwind-variants": "^4.0.2"
	}
}
